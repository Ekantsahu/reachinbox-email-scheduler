generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum EmailStatus {
  SCHEDULED
  PROCESSING
  SENT
  FAILED
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  name      String?
  avatarUrl String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  senders   Sender[]
  campaigns Campaign[]
  slackConnection SlackConnection?
}

model SlackConnection {
  id           String   @id @default(cuid())
  userId       String   @unique
  accessToken  String
  teamId       String?
  teamName     String?
  slackUserId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sender {
  id          String     @id @default(cuid())
  userId      String
  email       String
  name        String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user        User       @relation(fields: [userId], references: [id])
  campaigns   Campaign[]
  emails      Email[]

  @@unique([userId, email])
}

model Campaign {
  id             String   @id @default(cuid())
  userId         String
  senderId       String
  subject        String
  body           String
  startTime      DateTime
  delayMs        Int
  hourlyLimit    Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation(fields: [userId], references: [id])
  sender         Sender   @relation(fields: [senderId], references: [id])
  emails         Email[]
}

model Email {
  id          String      @id @default(cuid())
  campaignId  String
  senderId    String
  recipient   String
  subject     String
  body        String
  scheduledAt DateTime
  sentAt      DateTime?
  status      EmailStatus @default(SCHEDULED)
  messageId   String?
  error       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  campaign    Campaign    @relation(fields: [campaignId], references: [id])
  sender      Sender      @relation(fields: [senderId], references: [id])

  @@index([status])
  @@index([scheduledAt])
  @@index([recipient])
}